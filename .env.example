# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#   echo "ADMIN_TOKEN=$(openssl rand -hex 32)" >> .env

# REQUIRED. No default exists. Minimum 32 characters.
# This token authorizes tenant provisioning and API key minting on the admin
# port. Treat it like a root password. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Ports
INGEST_PORT=50051
ADMIN_PORT=50052
METRICS_PORT=9090

# Datastores
CLICKHOUSE_DSN=clickhouse://127.0.0.1:9000/lumen?dial_timeout=10s&compress=true
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/lumen?sslmode=disable

# Optional: MaxMind GeoLite2-City.mmdb path for GeoIP enrichment
GEOIP_DB_PATH=

# Development only. Generates a throwaway ADMIN_TOKEN at each startup instead
# of refusing to boot. Never set this in production.
# LUMEN_DEV=1

# Optional: load the above from Infisical instead of this file
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENV=prod
